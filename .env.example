# Copy this file to .env and fill in your own Supabase project's values.
# If left unset, the backend falls back to an in-memory transaction log
# (fine for local development, not for the deployed demo).

# Project Settings -> API -> Project URL
SUPABASE_URL=

# Project Settings -> API -> service_role secret key
# (server-side only -- this bypasses Row Level Security, never expose it
# to the dashboard/browser; the dashboard uses the anon key instead, see
# dashboard/.env.example once Phase 5 adds it)
SUPABASE_KEY=

SUPABASE_TABLE=transactions

# Seconds to wait between transactions in the simulated stream.
STREAM_DELAY_SECONDS=0.3

# Inject one synthetic obvious-anomaly transaction every N transactions.
SYNTHETIC_ANOMALY_EVERY_N=50

# How many random legitimate test-set rows to include in the demo stream
# (all fraud rows are always included -- see api/streamer.py).
DEMO_N_LEGIT=900

# Comma-separated list of allowed origins for CORS (e.g. your deployed
# Streamlit app's URL). "*" is fine for local dev / this demo.
ALLOWED_ORIGINS=*
